// Règles de la collection messages pour le projet Firebase cadeau-commentaire.
// À fusionner avec les règles existantes avant publication si le projet utilise
// d'autres collections.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'text', 'ownerId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'text', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if request.auth != null && (
        resource.data.get('ownerId', '') == request.auth.uid
        || (
          request.auth.token.get('email', '') == 'tubercrype@gmail.com'
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.firebase.sign_in_provider == 'google.com'
        )
      );
    }
  }
}
